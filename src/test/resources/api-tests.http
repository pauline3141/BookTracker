### Register
# @name register
POST http://localhost:8080/api/auth/register
Content-Type: application/json

{
  "username": "testuser",
  "password": "secret123"
}

### Login
# @name login
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "username": "testuser",
  "password": "secret123"
}

> {%
    client.global.set("authToken", response.body.token);
%}

### Health Check
GET http://localhost:8080/api/health

### POST new book
# @name createBook
POST http://localhost:8080/api/books
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Brave New World",
  "author": "Aldous Huxley",
  "isbn": "9780060850524",
  "coverUrl": null,
  "publishYear": 1932,
  "totalPages": 311
}

> {%
    client.global.set("bookId", response.body.id);
%}

### GET all books
GET http://localhost:8080/api/books
Authorization: Bearer {{authToken}}

### GET book by id (success)
GET http://localhost:8080/api/books/{{bookId}}
Authorization: Bearer {{authToken}}

### GET book by id (404)
GET http://localhost:8080/api/books/9999999
Authorization: Bearer {{authToken}}

### PUT book
PUT http://localhost:8080/api/books/{{bookId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Brave New World (überarbeitet)",
  "author": "Aldous Huxley",
  "isbn": "9780060850524",
  "coverUrl": null,
  "publishYear": 1932,
  "totalPages": 320
}

### POST a second book to test deletion
# @name createSecondBook
POST http://localhost:8080/api/books
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "1984",
  "author": "George Orwell",
  "isbn": "9780451524935",
  "coverUrl": null,
  "publishYear": 1949,
  "totalPages": 328
}

> {%
    client.global.set("secondBookId", response.body.id);
%}

### DELETE book
DELETE http://localhost:8080/api/books/{{secondBookId}}
Authorization: Bearer {{authToken}}

### DELETE book (404, already deleted)
DELETE http://localhost:8080/api/books/{{secondBookId}}
Authorization: Bearer {{authToken}}

### POST new shelf
# @name createShelf
POST http://localhost:8080/api/shelves
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Krimis",
  "description": "Spannungs- und Detektivromane"
}

> {%
    client.global.set("shelfId", response.body.id);
%}

### GET all shelves
GET http://localhost:8080/api/shelves
Authorization: Bearer {{authToken}}

### GET shelf by id (success)
GET http://localhost:8080/api/shelves/{{shelfId}}
Authorization: Bearer {{authToken}}

### GET shelf by id (404)
GET http://localhost:8080/api/shelves/9999999
Authorization: Bearer {{authToken}}

### PUT shelf
PUT http://localhost:8080/api/shelves/{{shelfId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Wunschliste 2026",
  "description": "Aktualisierte Wunschliste für das Jahr 2026"
}

### POST a second shelf to test deletion and moving
# @name createSecondShelf
POST http://localhost:8080/api/shelves
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Gelesen",
  "description": "Fertig gelesene Bücher"
}

> {%
    client.global.set("secondShelfId", response.body.id);
%}

### GET all entries
GET http://localhost:8080/api/shelves/{{shelfId}}/entries
Authorization: Bearer {{authToken}}

### POST book to shelf
# @name createEntry
POST http://localhost:8080/api/shelves/{{shelfId}}/entries
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "bookId": {{bookId}},
  "totalPages": 320
}

> {%
    client.global.set("entryId", response.body.id);
%}

### PATCH update progress
PATCH http://localhost:8080/api/shelves/{{shelfId}}/entries/{{entryId}}/progress
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "currentPage": 150,
  "totalPages": 320
}

### PATCH move entry to another shelf
PATCH http://localhost:8080/api/shelves/{{shelfId}}/entries/{{entryId}}/move
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "targetShelfId": {{secondShelfId}}
}

### GET notes of an entry
GET http://localhost:8080/api/entries/{{entryId}}/notes
Authorization: Bearer {{authToken}}

### POST notes with page reference
# @name createNote
POST http://localhost:8080/api/entries/{{entryId}}/notes
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "pageReference": 150,
  "content": "Starke Wendung auf dieser Seite"
}

> {%
    client.global.set("noteId", response.body.id);
%}

### POST note without page reference
POST http://localhost:8080/api/entries/{{entryId}}/notes
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "pageReference": null,
  "content": "Insgesamt ein großartiges Buch"
}

### PUT update note
PUT http://localhost:8080/api/notes/{{noteId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "pageReference": 200,
  "content": "Korrigierte Notiz"
}

### DELETE note
DELETE http://localhost:8080/api/notes/{{noteId}}
Authorization: Bearer {{authToken}}

### DELETE entry (now on second shelf after move)
DELETE http://localhost:8080/api/shelves/{{secondShelfId}}/entries/{{entryId}}
Authorization: Bearer {{authToken}}

### DELETE shelf
DELETE http://localhost:8080/api/shelves/{{secondShelfId}}
Authorization: Bearer {{authToken}}

### DELETE shelf (404, already deleted)
DELETE http://localhost:8080/api/shelves/{{secondShelfId}}
Authorization: Bearer {{authToken}}

### POST validation error
POST http://localhost:8080/api/books
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "",
  "author": "",
  "isbn": "123",
  "coverUrl": null,
  "publishYear": 0,
  "totalPages": 0
}

### Open Library search books
GET http://localhost:8080/api/books/search?q=tolkien
Authorization: Bearer {{authToken}}

### Open Library unknown book
GET http://localhost:8080/api/books/search?q=xyzxyzxyznotabook123
Authorization: Bearer {{authToken}}

### Register duplicate username (expect 409)
POST http://localhost:8080/api/auth/register
Content-Type: application/json

{
  "username": "testuser",
  "password": "secret123"
}